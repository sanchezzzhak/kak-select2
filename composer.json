{
  "name": "kak/select2",
  "description": "select2 widgets for Yii2",
  "type": "library",
  "support": {
    "issues": "https://github.com/sanchezzzhak/kak-select2/issues?state=open",
    "source": "https://github.com/sanchezzzhak/kak-select2"
  },
  "keywords": [
    "yii2",
    "select2 yii2",
    "kak select2"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Tutik Alexsandr",
      "email": "sanchezzzhak@ya.ru"
    }
  ],
  "require": {
    "yiisoft/yii2": "*",
    "bower-asset/select2": "^4.0",
    "bower-asset/slimscroll": "*"
  },
  "require-dev": {
    "symfony/event-dispatcher-contracts": ">=2.2.0",
    "yiisoft/yii2-bootstrap": "*"
  },
  "autoload": {
    "psr-4": {
      "kak\\widgets\\select2\\": "src"
    }
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://asset-packagist.org"
    }
  ],
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": false
    }
  },
  "archive": {
    "exclude": [
      "/demo"
    ]
  }
}
